# Install as /etc/kenpi/backup.env (root:kenpi 0640), then: systemctl enable --now kenpi-backup.timer
# Local USB:  local:/media/kenpi-usb
# SFTP:       sftp://backup@host.example:22/srv/kenpi   (set KENPI_SFTP_IDENTITY / KENPI_SFTP_KNOWN_HOSTS)
KENPI_BACKUP_DEST=local:/media/kenpi-usb
KENPI_BACKUP_KEEP=14
